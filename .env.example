# Variable names with harmless placeholders only. Never commit real values.
# Copy to .env (gitignored) for local overrides.

# Optional: Solana RPC override (default: public mainnet-beta, rate-limited)
SOLSNIPE_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: local dashboard/API bind (default 127.0.0.1; never expose)
SOLSNIPE_BIND_HOST=127.0.0.1
SOLSNIPE_PORT=3000

# Optional: local token guarding state-changing routes (set a random value)
SOLSNIPE_LOCAL_TOKEN=change-me-to-a-random-string

# Recorder tuning (defaults documented in code)
SOLSNIPE_RECORDER_INTERVAL_MS=15000
SOLSNIPE_RECORDER_DB_PATH=./data/snapshots.sqlite
